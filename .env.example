# MongoDB Connection URL (Local or Atlas)
# Example local: mongodb://localhost:27017/food_waste_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_waste_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/food_waste_db
DB_NAME=food_waste_db

# Server Configuration
PYTHON_PORT=5000
NODE_PORT=3000
FLASK_ENV=development
NODE_ENV=development

# Machine Learning & Waste Classification Thresholds
# High waste definition threshold in percentage (e.g., waste > 15% is tagged HIGH WASTE)
WASTE_THRESHOLD_PERCENT=15.0

# Minimum labeled meals required to allow model retraining
MIN_RETRAIN_RECORDS=50
